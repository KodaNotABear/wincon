# Copy to .env and fill in. Get a development key at https://developer.riotgames.com
# Dev keys expire every 24 hours; regenerate and re-paste when sync starts returning 403.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Your Riot ID as shown in the client, GameName#TAG
RIOT_ID=YourName#NA1

# Regional routing for account-v1 and match-v5: americas, europe, asia, or sea
REGION=americas

# How many recent ranked games to pull (each game costs 2 API calls)
COUNT=40

# 420 = ranked solo/duo, 440 = ranked flex
QUEUE=420
